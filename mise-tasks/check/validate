#!/usr/bin/env bash
#MISE description="Strictly validate the marketplace manifest and each plugin"
#MISE tools={claude="2.1.289"}
#MISE env={DISABLE_AUTOUPDATER="1"}
#USAGE arg "[plugin]..." help="Plugin or marketplace folders; default: the repo root and every folder under plugins/"
set -euo pipefail
source ci/each-plugin.sh

validate() {
  local rc=0
  claude plugin validate --strict "$1" || rc=1
  # Claude Code updates a plugin only when its version changes, and release-please
  # bumps only the plugins listed in its config.
  if [ "$1" != . ] && ! jq -e --arg p "${1%/}" '.packages[$p]' release-please-config.json >/dev/null; then
    echo "${1%/} is missing from release-please-config.json, so its version would never be bumped"
    rc=1
  fi
  return "$rc"
}

if [ $# -eq 0 ]; then
  mapfile -d '' -t dirs < <(plugin_dirs)
  set -- . "${dirs[@]}"
fi
each_plugin validate "$@"
