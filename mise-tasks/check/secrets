#!/usr/bin/env bash
#MISE description="Scan git commits for secrets (gitleaks)"
#MISE tools={gitleaks="8.30.1"}
#USAGE arg "[log-opts]..." help="git log options picking the commits, e.g. main..HEAD; default: the full history"
# Rules and allowlists come from .gitleaks.toml. CI passes a PR's base..head and
# scans the full history on main; a pre-push hook can pass just the pushed commits.
# --redact keeps a found secret out of the (public) CI log.
set -euo pipefail

args=(git --no-banner --verbose --redact --config .gitleaks.toml)
if [ $# -gt 0 ]; then
  # gitleaks reports "no leaks found" and exits 0 when git rejects the
  # options (e.g. an unknown ref), so let git fail first.
  git log --format=%H "$@" >/dev/null
  args+=(--log-opts "$*")
fi
gitleaks "${args[@]}" .
