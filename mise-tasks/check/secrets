#!/usr/bin/env bash
#MISE description="Scan git commits, or the uncommitted changes, for secrets (gitleaks)"
#MISE tools={gitleaks="8.30.1"}
#USAGE flag "--uncommitted" help="Scan the files that differ from HEAD, plus untracked ones, instead of commits"
#USAGE arg "[log-opts]..." help="git log options picking the commits, e.g. main..HEAD; default: the full history"
# Rules and allowlists come from .gitleaks.toml. CI passes a PR's base..head and
# scans the full history on main; the pre-push hook passes just the pushed commits,
# and the agent hook in .claude/settings.json scans --uncommitted before `but commit`.
# --redact keeps a found secret out of the (public) CI log and the agent's context.
set -euo pipefail

if [ "${usage_uncommitted:-}" = true ]; then
  # GitButler doesn't stage, so take every changed or untracked file, copy just
  # those into a scratch dir and scan that, keeping repo-relative paths.
  config=$PWD/.gitleaks.toml
  scratch=$(mktemp -d)
  trap 'rm -rf "$scratch"' EXIT
  { git diff -z --name-only --diff-filter=d HEAD; git ls-files -z --others --exclude-standard; } |
    tar -cf - --null -T - | tar -xf - -C "$scratch"
  cd "$scratch"
  exec gitleaks dir --no-banner --no-color --verbose --redact --config "$config" .
fi

args=(git --no-banner --verbose --redact --config .gitleaks.toml)
if [ $# -gt 0 ]; then
  # gitleaks reports "no leaks found" and exits 0 when git rejects the
  # options (e.g. an unknown ref), so let git fail first.
  git log --format=%H "$@" >/dev/null
  args+=(--log-opts "$*")
fi
gitleaks "${args[@]}" .
