#!/usr/bin/env bash
#MISE description="Fail any plugin function over the complexity limit"
#MISE tools={ruff="0.17.0"}
#USAGE arg "[plugin]..." help="Plugin folders to check; default: every folder under plugins/"
# McCabe complexity (ruff C901). The limit is lint.mccabe.max-complexity in
# ruff.toml. tests/ is exempt: fakes and table-driven tests don't ship to users.
set -euo pipefail
source ci/each-plugin.sh

complexity() {
  has_python "$1" || { echo "no Python files"; return 0; }
  ruff check --no-cache --select C901 --extend-exclude tests "$1"
}

each_plugin complexity "$@"
