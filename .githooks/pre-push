#!/usr/bin/env bash
# Scans the commits a push adds for secrets: the last local gate, and one GitButler
# runs (`but push` skips it only with --no-verify). `mise run setup` installs it.
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

remote=$1
refs=0 tips=()
while read -r _ sha _ _; do
  refs=$((refs + 1))
  # An all-zero sha deletes the remote branch: nothing to scan.
  [[ $sha =~ ^0+$ ]] || tips+=("$sha")
done
# No ref lines (a tool that doesn't pass them): scan everything unpushed instead.
[ "$refs" -gt 0 ] || tips=(HEAD)
[ ${#tips[@]} -gt 0 ] || exit 0

# What the push adds: commits not yet on any of the remote's branches.
exec mise run -q check:secrets "${tips[@]}" --not --remotes="$remote" </dev/null
