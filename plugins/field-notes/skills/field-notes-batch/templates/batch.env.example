# batch.env: settings for one batch run. Copy it into the run folder and edit it.
# Sourced by bash. Relative paths are relative to the run folder. Every plain variable here is
# also available to the prompt templates as {{NAME}}.

GROUP="AWS"                         # sessions are named "<GROUP> - <item name>"
MODEL="<model id>"                  # the same model for the base and every fork
WORK_DIR="."                        # the directory every session runs in (base and forks alike)

# Flags for every claude call, base and forks alike. Change them only before `batch.sh base`:
# a fork with different flags misses the base's cache. Use absolute paths.
FIELD_NOTES_PLUGIN="$HOME/Projects/claude-plugins/plugins/field-notes"
INSPIRATION="$PWD/inspiration"      # optional; passed to the field-notes skill by base-load.md
CLAUDE_FLAGS=(
  --strict-mcp-config
  --permission-mode acceptEdits
  --allowedTools "Bash Read Write Edit Glob Grep Skill"
  --plugin-dir "$FIELD_NOTES_PLUGIN"
  --add-dir "$INSPIRATION"
  --add-dir "$FIELD_NOTES_PLUGIN/skills/field-notes"
)

BASE_LOAD="base-load.md"            # turn 1 of the base: load the skill, examples and tools
RUN_PROMPT="run-prompt.md"          # turn 2 of the base: the shared task, ends "Reply with exactly OK"
# The first message of each fork. {{KEY}} is the item key, {{NAME}} the session name.
ITEM_MESSAGE='Your icon: {{KEY}}'
# Appended to ITEM_MESSAGE on a redo. {{FEEDBACK}} is the notes file's text.
REDO_MESSAGE='A previous attempt at this icon was rejected. Fix these problems:
{{FEEDBACK}}'

NAMES="names.tsv"                   # optional: key<TAB>item name, for session names
APPROVED="approved.txt"             # one key per line; these are never redrawn by `item`

# Governor. Leave RAM headroom: the RAM check happens only when a fork starts, and forks grow.
MAX=4                               # 24 worked on a 15 GB laptop
MIN_MB=3500                         # MB of RAM that must be free to start one more fork
STAGGER=3                           # seconds between starts; 15 starved the pool
